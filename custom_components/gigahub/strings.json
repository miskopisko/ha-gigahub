        },
        "data_description": {
          "fast_interval": "Download and upload speeds are averaged over this interval.",
          "slow_interval": "The device list is the hub's heaviest request, so poll it less often.",
          "speed_test_interval": "Hours between automatic speed tests. 0 turns them off. Each test fills the line for about 30 seconds; its traffic is left out of the data totals.",
